# ==============================================================================
# .NET / Avalonia (C#)
# ==============================================================================
# Foldery kompilacji i wyniki budowania
[Bb]in/
[Oo]bj/
[Oo]ut/

# Pliki konfiguracyjne użytkownika
*.user
*.userosscache
*.sln.docstates

# ==============================================================================
# JetBrains Rider / ReSharper
# ==============================================================================
# Katalog ustawień lokalnych IDE
.idea/
*.sln.iml
*.DotSettings.user

# Pliki tymczasowe ReSharpera
_ReSharper*/
*.[Rr]e[Ss]harper

# ==============================================================================
# Visual Studio (na wypadek, gdyby ktoś z zespołu używał VS)
# ==============================================================================
.vs/
*.suo
*.dbmdl
*.jfm
*.pfx
*.publishsettings

# ==============================================================================
# System operacyjny i pliki tymczasowe
# ==============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ==============================================================================
# Inne (logi, testy)
# ==============================================================================
# Pliki logów
*.log

# Wyniki testów (TestResults)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.testsettings
